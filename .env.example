# Supabase Postgres for Vercel / serverless.
# Prefer the **Transaction pooler** (port 6543). Direct db.*:5432 often fails from Vercel (P1001).
# The app also rewrites direct URLs to the pooler at runtime and falls back to session-mode :5432.
#
# Transaction pooler (recommended):
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Optional — used when rewriting a direct db.* URL or building pooler fallbacks.
# SUPABASE_PROJECT_REF="hbnwdpvvvemwdgawzjat"
# SUPABASE_POOLER_REGION="us-west-2"

# Long-lived admin session (login is password-only)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_USERNAME="amfs"
AUTH_PASSWORD="change-me"

# Optional — stable IDs used only when login succeeds but Postgres is briefly unreachable.
# BOOTSTRAP_ORG_ID=""
# BOOTSTRAP_USER_ID=""

# Failure alerts go here — never to the AMFS operator
MAINTAINER_EMAIL="you@example.com"
RESEND_API_KEY=""
# Verified sender domain in Resend (defaults to onboarding@resend.dev for smoke tests)
RESEND_FROM="HydroIQ Alerts <onboarding@resend.dev>"

# Optional. Without it, HydroIQ uses USASpending.gov (public, no key) for awards
# and SAM.gov's public search when available.
SAM_API_KEY=""

# Vercel Cron bearer token
CRON_SECRET="replace-me"
