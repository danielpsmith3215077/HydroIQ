# Supabase connection for Vercel / serverless — prefer **Transaction pooler** (:6543):
# postgresql://postgres.[ref]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
# Direct db.*:5432 also works; the app rewrites it to the pooler at runtime when needed.
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Long-lived admin session (login is password-only)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_USERNAME="amfs"
AUTH_PASSWORD="change-me"

# Failure alerts go here — never to the AMFS operator
MAINTAINER_EMAIL="you@example.com"
RESEND_API_KEY=""
# Verified sender domain in Resend (defaults to onboarding@resend.dev for smoke tests)
RESEND_FROM="HydroIQ Alerts <onboarding@resend.dev>"

# Optional. Without it, HydroIQ uses USASpending.gov (public, no key) for awards
# and SAM.gov's public search when available.
SAM_API_KEY=""

# Vercel Cron bearer token
CRON_SECRET="replace-me"
